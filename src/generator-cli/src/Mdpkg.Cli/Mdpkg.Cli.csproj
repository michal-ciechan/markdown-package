<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The executable and the `dotnet mdpkg` verb are both named mdpkg (spec §1). -->
    <AssemblyName>mdpkg</AssemblyName>
    <RootNamespace>Mdpkg.Cli</RootNamespace>
    <!-- A global tool should run on any newer runtime the host has. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mdpkg</ToolCommandName>
    <PackageId>mdpkg</PackageId>
    <Version>0.1.0-scaffold</Version>
    <Authors>markdown-package contributors</Authors>
    <Description>Creates and validates .mdpkg packages with Markdown addressing and curated Git history. Update and address editing are not yet implemented.</Description>
    <PackageProjectUrl>https://github.com/michal-ciechan/markdown-package</PackageProjectUrl>
    <RepositoryUrl>https://github.com/michal-ciechan/markdown-package</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Mdpkg.Reader/Mdpkg.Reader.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Mdpkg.Cli.Tests" />
  </ItemGroup>

</Project>
