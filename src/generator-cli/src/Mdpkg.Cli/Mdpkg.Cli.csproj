<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The executable and the `dotnet mdpkg` verb are both named mdpkg (spec §1). -->
    <AssemblyName>mdpkg</AssemblyName>
    <RootNamespace>Mdpkg.Cli</RootNamespace>
    <!-- A global tool should run on any newer runtime the host has. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mdpkg</ToolCommandName>
    <PackageId>mdpkg</PackageId>
    <Description>Package Markdown snapshots and curated Git history as .mdpkg archives with stable addressing, and validate their content and repository integrity.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Mdpkg.Core/Mdpkg.Core.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../Mdpkg.Reader/Internal/Sources/UNICODE-LICENSE.txt" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Mdpkg.Cli.Tests" />
  </ItemGroup>

</Project>
