<Project>
  <!-- Bump this one version for the coordinated mdpkg, Reader and Core release.
       Reviews shares the build version but is not published by this workflow. -->
  <PropertyGroup>
    <Version>0.1.0-preview.3</Version>
    <Authors>markdown-package contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/michal-ciechan/markdown-package</PackageProjectUrl>
    <RepositoryUrl>https://github.com/michal-ciechan/markdown-package</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>mdpkg;markdown;git;documents;review</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
